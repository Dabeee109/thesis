{
  "name": "diners-cafe-ordering-system",
  "version": "1.0.0",
  "description": "AI-Powered Conversational Cafe Operations and Smart Delivery Management System with Facebook Messenger Integration",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "tunnel": ".\\cloudflared.exe tunnel --url http://localhost:3000 --http-host-header localhost:3000",
    "tunnel:cf": ".\\cloudflared.exe tunnel --url http://localhost:3000 --http-host-header localhost:3000",
    "tunnel:cf:permanent": "node -e \"require('dotenv').config(); require('child_process').spawn('.\\\\cloudflared.exe',['tunnel','run','--token',process.env.CLOUDFLARE_TUNNEL_TOKEN],{stdio:'inherit'})\"",
    "cap:init": "cap init",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android"
  },
  "keywords": [
    "cafe-ordering",
    "facebook-messenger-bot",
    "delivery-management",
    "smart-fare-calculation",
    "inventory-management",
    "capacitor-android-app"
  ],
  "author": "Diner's Cafe Team",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@google/genai": "^2.32.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "mysql2": "^3.12.0",
    "tesseract.js": "^7.0.0"
  }
}
