# Server Configuration
PORT=3000
NODE_ENV=development
APP_NAME="Diner's Cafe Ordering & Delivery System"
APP_URL=http://localhost:3000

# Database Configuration (MySQL / XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=diners_cafe_db

# JWT Authentication Secret
JWT_SECRET=diners_cafe_super_secure_secret_key_2026_thesis

# Facebook Messenger & Webhook Security Configuration
# Webhook verification token used for GET /api/webhook & GET /webhook challenge handshake
FB_VERIFY_TOKEN=diners_cafe_verify_token_2026
# Page Access Token from Meta Developer Portal (starts with EAA...)
FB_PAGE_ACCESS_TOKEN=EAAB_YOUR_PAGE_ACCESS_TOKEN_HERE
# Optional: Meta App Secret for X-Hub-Signature-256 HMAC payload validation
FB_APP_SECRET=
# Optional: Shared secret header (X-Webhook-Secret) for custom POST /api/webhook callers
WEBHOOK_SECRET=
# Optional: Cloudflare Zero Trust Named Tunnel Token (3fdec661-...) for permanent webhook URL
CLOUDFLARE_TUNNEL_TOKEN=

# Google AI Studio (Gemini API via @google/genai)
# Generate an API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Recommended current Flash model (replaces legacy gemini-2.5-flash)
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT_MS=45000

# Store Information & Entrance Coordinates
STORE_NAME="Diner's Cafe"
STORE_PHONE="+63 912 345 6789"
STORE_ADDRESS="123 Academic Hub Ave., University District"
STORE_GCASH_NAME="FR****S DA*E F."
STORE_GCASH_NUMBER="0928 176 2895"
STORE_HOURS="Monday - Sunday: 8:00 AM - 9:00 PM"
STORE_MAX_DELIVERY_KM=3.0

# Store coordinates (Shop entrance: replace these placeholders by right-clicking the entrance in Google Maps and copying the coordinates)
STORE_LAT=14.6042
STORE_LNG=120.9822

# System Timezone (Default: Asia/Manila)
TZ_NAME=Asia/Manila

# Maps Provider Configuration ('google' | 'mock' | '')
# Leave blank or 'mock' for local development. In production, 'google' and GOOGLE_MAPS_API_KEY are required.
MAPS_PROVIDER=mock
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
MAPS_TIMEOUT_MS=5000

# Delivery Rules & Quote Configuration
QUOTE_TTL_SEC=600
BICYCLE_MAX_KM=1.5
ROUTE_CACHE_TTL_SEC=600

# Weather Service Configuration
OPENWEATHER_API_KEY=
HEAVY_RAIN_MM_H=7.5

# Xendit Payment Gateway Configuration
XENDIT_SECRET_KEY=xnd_development_your_secret_key_here
XENDIT_CALLBACK_TOKEN=your_xendit_callback_verification_token
APP_BASE_URL=https://diners-cafe-bot1.onrender.com

